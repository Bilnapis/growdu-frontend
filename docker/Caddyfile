{
	email {$ACME_EMAIL}
	admin off
}

{$APP_DOMAIN} {
	encode zstd gzip

	@private path /backend-admin /backend-admin/* /docs /docs/* /docs-json /docs-yaml /storage /storage/*
	handle @private {
		respond 404
	}

	@backend path /api /api/* /uploads /uploads/*
	handle @backend {
		reverse_proxy backend:3000
	}

	handle /assets/* {
		root * /srv
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	handle {
		root * /srv
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}

# Internal liveness check; this port is not published by Compose.
:8080 {
	respond /healthz "ok" 200
}
